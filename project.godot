; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Hotfix Friday"
run/main_scene="res://scenes/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="hotfix_friday"
config/icon="res://icon.png"
config/version="0.3.0"

[autoload]

Session="*res://scripts/session.gd"
Audio="*res://scripts/audio.gd"
Settings="*res://scripts/settings.gd"
Stats="*res://scripts/stats.gd"
Tournament="*res://scripts/tournament/tournament.gd"

[display]

window/size/width=800
window/size/height=480
window/stretch/mode="2d"
window/stretch/aspect="keep"

[gui]

theme/custom="res://assets/theme.tres"

[locale]

translations=PoolStringArray( "res://locale/translations.it.translation", "res://locale/translations.en.translation" )

[physics]

2d/default_gravity=900

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0.07, 0.08, 0.12, 1 )
