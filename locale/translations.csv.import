[remap]

importer="csv_translation"
type="Translation"

[deps]

files=[ "res://locale/translations.it.translation", "res://locale/translations.en.translation" ]

source_file="res://locale/translations.csv"
dest_files=[ "res://locale/translations.it.translation", "res://locale/translations.en.translation" ]

[params]

compress=true
delimiter=0
